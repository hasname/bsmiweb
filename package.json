{
  "name": "bsmiweb",
  "version": "1.0.0",
  "description": "Build tooling for the self-hosted Sentry browser asset; the application runs in Go.",
  "type": "module",
  "scripts": {
    "build": "esbuild browser/sentry.js --bundle --minify --format=iife --global-name=Sentry --outfile=internal/web/static/sentry.min.js && cp node_modules/@sentry/browser/LICENSE internal/web/static/sentry-LICENSE.txt"
  },
  "author": "Gea-Suan Lin <gslin@gslin.com>",
  "license": "MIT",
  "devDependencies": {
    "@sentry/browser": "10.45.0",
    "esbuild": "0.27.4"
  }
}

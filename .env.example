# SQLite (local development, default)
DATABASE_URL="file:./prisma/dev.db"

# MySQL (production)
# DATABASE_URL="mysql://user:password@localhost:3306/bsmiweb"

# Explicit Go driver/DSN override (set both); overrides DATABASE_URL and MYSQL_*.
# BSMI_DRIVER=mysql
# BSMI_DSN="user:password@tcp(localhost:3306)/bsmiweb"

# Existing production MYSQL_HOST, MYSQL_PORT, MYSQL_DATABASE, MYSQL_USER,
# MYSQL_PASSWORD settings remain supported with NODE_ENV=production.

# BSMI_HTTP_ADDR overrides PORT (default 3000).
# BSMI_HTTP_ADDR=127.0.0.1:3000
# TZ=Asia/Taipei
# SENTRY_DSN_WEB=
# SENTRY_DSN_CRON=
# SENTRY_DSN_FRONTEND=

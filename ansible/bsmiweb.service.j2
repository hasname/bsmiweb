[Unit]
Description=bsmiweb web server
After=network.target

[Service]
Type=simple
WorkingDirectory={{ deploy_path }}
Environment=NODE_ENV=production
EnvironmentFile={{ deploy_path }}/.env
ExecStart={{ deploy_path }}/bsmiweb serve
TimeoutStopSec=30
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

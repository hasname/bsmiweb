[Unit]
Description=bsmiweb cron job
After=network.target

[Service]
Type=simple
WorkingDirectory={{ deploy_path }}
Environment=NODE_ENV=production
EnvironmentFile={{ deploy_path }}/.env
ExecStart={{ deploy_path }}/bsmiweb cron
TimeoutStopSec=90
Restart=always
RestartSec=5

[Install]
WantedBy=default.target

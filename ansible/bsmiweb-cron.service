[Unit]
Description=bsmiweb cron job
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/service/bsmiweb
EnvironmentFile=/home/service/bsmiweb/.env
Environment=NODE_ENV=production
ExecStart=/home/service/bsmiweb/bsmiweb cron
TimeoutStopSec=90
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
